APP_NAME=Ecommerce Recommendation Service
APP_ENV=production
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8001
API_ROOT_PATH=/ai

DB_HOST=mysql.example.internal
DB_PORT=3306
DB_NAME=ecommerce_recommendation
DB_USER=recommendation_app
DB_PASSWORD=replace_with_database_password

REDIS_HOST=redis.example.internal
REDIS_PORT=6379
REDIS_DB=1
REDIS_USERNAME=default
REDIS_PASSWORD=replace_with_redis_password
REDIS_SSL=true

RABBITMQ_HOST=rabbitmq.example.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=recommendation_app
RABBITMQ_PASSWORD=replace_with_rabbitmq_password
RABBITMQ_QUEUE=recommendation_events

QDRANT_HOST=qdrant.example.internal
QDRANT_PORT=6333
QDRANT_COLLECTION=products
QDRANT_VECTOR_SIZE=1536
QDRANT_HTTPS=true
QDRANT_API_KEY=replace_with_qdrant_api_key

OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
LARAVEL_API_URL=https://shop.example.com
LARAVEL_API_TOKEN=replace_with_laravel_api_token
