APP_NAME=Ecommerce
APP_ENV=production
APP_KEY=base64:replace_with_generated_key
APP_DEBUG=false
APP_URL=https://shop.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce_app
DB_PASSWORD=replace_with_database_password

CACHE_STORE=redis
CACHE_PREFIX=ecommerce-cache-
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=shop.example.com
QUEUE_CONNECTION=rabbitmq

REDIS_HOST=redis.example.internal
REDIS_PASSWORD=replace_with_redis_password
REDIS_PORT=6379
REDIS_DB=0

RABBITMQ_HOST=rabbitmq.example.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=ecommerce_app
RABBITMQ_PASSWORD=replace_with_rabbitmq_password
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ecommerce
REVERB_APP_KEY=replace_with_reverb_app_key
REVERB_APP_SECRET=replace_with_reverb_app_secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=shop.example.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_ALLOWED_ORIGINS=shop.example.com

CLOUDINARY_URL=cloudinary://replace_key:replace_secret@replace_cloud_name
